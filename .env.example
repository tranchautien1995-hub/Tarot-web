# Supabase (nếu bạn đang dùng đăng nhập)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Chỉ dùng ở server. Tuyệt đối không thêm tiền tố NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=

# Domain production, không có dấu / ở cuối.
NEXT_PUBLIC_SITE_URL=https://tarotbytien.io.vn

# Thanh toán VietQR tự động qua SePay. Chỉ dùng ở server.
# Mã ngân hàng VietQR (ví dụ: MBBank, VCB, ACB).
SEPAY_BANK_CODE=
SEPAY_ACCOUNT_NUMBER=
SEPAY_ACCOUNT_NAME=
# Phải giống Secret Key HMAC-SHA256 khi tạo webhook trên SePay.
SEPAY_WEBHOOK_SECRET=

# XAH / GPT-6 Astra — dùng router /chat/completions
XAH_API_KEY=
XAH_BASE_URL=https://api.xah.io/v1
# Model dành cho tài khoản Free.
XAH_FREE_MODEL=gpt-5.6-sol

# Model dành cho Plus, Pro, Pro Max và Admin.
XAH_PREMIUM_MODEL=gpt-6-astra

# Tương thích với bản cũ; chỉ dùng khi chưa khai báo XAH_PREMIUM_MODEL.
XAH_MODEL=gpt-6-astra

# API dự phòng 1 — dùng API key và model riêng.
XAH_FALLBACK_API_KEY=KEY_API_PHU
XAH_FALLBACK_BASE_URL=https://api.xah.io/v1
XAH_FALLBACK_FREE_MODEL=gpt-5.6-sol
XAH_FALLBACK_PREMIUM_MODEL=thanhnhan9023/gpt-6-astra

# API dự phòng 2 (không bắt buộc).
XAH_FALLBACK_2_API_KEY=
XAH_FALLBACK_2_BASE_URL=https://api.xah.io/v1
XAH_FALLBACK_2_FREE_MODEL=gpt-5.6-sol
XAH_FALLBACK_2_PREMIUM_MODEL=gpt-6-astra

# Sau 25 giây chưa nhận phản hồi đầu tiên, tự chuyển API dự phòng.
XAH_FIRST_BYTE_TIMEOUT_MS=25000
# API chính lỗi thì ưu tiên API phụ trong 60 giây tiếp theo.
XAH_FAILOVER_COOLDOWN_MS=60000

# Không cần XAH_REASONING_EFFORT.
