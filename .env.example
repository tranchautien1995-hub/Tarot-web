# Supabase (nếu bạn đang dùng đăng nhập)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Chỉ dùng ở server. Tuyệt đối không thêm tiền tố NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=

# Domain production, không có dấu / ở cuối.
NEXT_PUBLIC_SITE_URL=https://tarotbytien.io.vn

# Thanh toán VietQR tự động qua SePay. Chỉ dùng ở server.
# Mã ngân hàng VietQR (ví dụ: MBBank, VCB, ACB).
SEPAY_BANK_CODE=
SEPAY_ACCOUNT_NUMBER=
SEPAY_ACCOUNT_NAME=
# Phải giống Secret Key HMAC-SHA256 khi tạo webhook trên SePay.
SEPAY_WEBHOOK_SECRET=

# Chỉ hai provider server-side; không dùng NEXT_PUBLIC_ cho API key.
# APIZ chính cho Tarot ngoài 3 lá và Lenormand.
APIZ_API_KEY=
APIZ_BASE_URL=https://api.apiz.vn/v1
APIZ_MODEL=gpt-6-astra

# CKEY / XAH: Tarot 3 lá dùng Sol, dự phòng Astra cho các trải khác.
XAH_API_KEY=
XAH_BASE_URL=https://api.xah.io/v1
XAH_FREE_MODEL=gpt-5.6-sol
XAH_PREMIUM_MODEL=gpt-6-astra

# Chỉ fallback khi provider đầu chưa stream nội dung.
XAH_FIRST_BYTE_TIMEOUT_MS=25000
XAH_STREAM_TIMEOUT_MS=120000
XAH_NON_STREAM_TIMEOUT_MS=60000

# AI_*_WEIGHT, XAH_FALLBACK_* và PROMPT_LAB_MODEL cũ không còn được dùng.
